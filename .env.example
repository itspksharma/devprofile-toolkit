# Reference only: export these variables in your shell or hosting dashboard.
# Django does not automatically load this file.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required when DJANGO_DEBUG=false. Generate a new random value.
DJANGO_SECRET_KEY=
# Optional server-side tokens. Public resources only; never put these in the UI.
GITHUB_TOKEN=
GITLAB_TOKEN=
# Production reverse-proxy settings, opt in for your actual hosting configuration.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY=false
